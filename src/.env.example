# ─────────────────────────────────────────────────────────────────────────────
# Personal Learning OS backend (src/plos) — environment configuration.
# Copy to `.env` (next to pyproject.toml) and edit. Every variable is prefixed
# `PLOS_`; all provider seams default to stub/dev, so the app boots with this
# file empty (zero external services). Flip an `*_engine` + provide credentials
# to engage the real provider. See docs/API协议.md §10.1.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──
PLOS_DEBUG=false
PLOS_ENV=dev                       # dev | prod
PLOS_CORS_ORIGINS=["*"]            # JSON array, e.g. ["http://localhost:3000"]

# ── Database (async SQLAlchemy + asyncpg; pgvector required) ──
PLOS_DATABASE_URL=postgresql+asyncpg://plos:plos@localhost:5432/plos
PLOS_DB_POOL_SIZE=10
PLOS_DB_MAX_OVERFLOW=20
PLOS_DB_ECHO=false

# ── Domain constants ──
PLOS_WEAK_THRESHOLD=0.6            # mastery level strictly below this => weakPoint
PLOS_EMBEDDING_DIM=1024            # BGE-M3 = 1024 (do not change after seeding)
PLOS_DEFAULT_LEARNER_ID=stu_001

# ── Provider engine selection (config-driven seams) ──
PLOS_LLM_ENGINE=stub               # stub | litellm
PLOS_EMBEDDING_ENGINE=stub         # stub | bge
PLOS_RAG_ENGINE=stub               # stub | llamaindex
PLOS_MEMORY_ENGINE=stub            # stub | mem0
PLOS_AUTH_ENGINE=dev               # dev | pocketbase

# ── LLM (LiteLLM) — set when PLOS_LLM_ENGINE=litellm ──
# PLOS_LITELLM_MODEL=openai/gpt-4o-mini
# PLOS_LITELLM_API_KEY=sk-...
# PLOS_LITELLM_API_BASE=                 # optional, for OpenAI-compatible gateways

# ── Embedding (BGE-M3) — set when PLOS_EMBEDDING_ENGINE=bge ──
PLOS_BGE_MODEL=BAAI/bge-m3

# ── Auth (PocketBase) — set when PLOS_AUTH_ENGINE=pocketbase (enables strict mode) ──
# PLOS_POCKETBASE_URL=http://127.0.0.1:8090
# PLOS_POCKETBASE_ADMIN_TOKEN=...
PLOS_AUTH_TOKEN_CACHE_TTL=60

# ── Memory pipeline timing ──
PLOS_MEMORY_L2_DEBOUNCE_SEC=4.0
PLOS_MEMORY_L3_IDLE_SEC=600.0

# ── WebSocket ──
PLOS_WS_PING_INTERVAL=20

# ── Runtime helpers ──
PLOS_SEED_ON_START=true            # idempotently seed stu_001 demo data on boot
PLOS_AUTO_CREATE_TABLES=true       # dev affordance; prod: use Alembic + set false
