# Personal Learning OS backend environment template
# Copy this file to `.env` and adjust values for your local setup.

# General
PLOS_APP_NAME=Personal Learning OS
PLOS_DEBUG=false
PLOS_ENV=dev
PLOS_CORS_ORIGINS=["*"]

# Database
PLOS_DATABASE_URL=postgresql+asyncpg://plos:plos@localhost:5432/plos
PLOS_DB_POOL_SIZE=10
PLOS_DB_MAX_OVERFLOW=20
PLOS_DB_ECHO=false
PLOS_DB_SSL=auto
PLOS_DB_POOL_MODE=standard

# Domain constants
PLOS_WEAK_THRESHOLD=0.6
PLOS_EMBEDDING_DIM=1024
PLOS_DEFAULT_LEARNER_ID=stu_001

# Provider engine selection
PLOS_LLM_ENGINE=stub
PLOS_EMBEDDING_ENGINE=stub
PLOS_RAG_ENGINE=stub
PLOS_MEMORY_ENGINE=stub
PLOS_AUTH_ENGINE=dev

# LLM (LiteLLM; used when PLOS_LLM_ENGINE=litellm)
PLOS_LITELLM_MODEL=
PLOS_LITELLM_API_KEY=
PLOS_LITELLM_API_BASE=

# LLM (DeepTutor service; used when PLOS_LLM_ENGINE=deeptutor)
# Run DeepTutor separately, e.g. `deeptutor serve --port 8002`.
# Set PLOS_DEEPTUTOR_TOKEN only when DeepTutor authentication is enabled.
PLOS_DEEPTUTOR_BASE_URL=http://127.0.0.1:8002
PLOS_DEEPTUTOR_TOKEN=
PLOS_DEEPTUTOR_CAPABILITY=chat
PLOS_DEEPTUTOR_LANGUAGE=zh

# Embedding (BGE-M3)
PLOS_BGE_MODEL=BAAI/bge-m3

# Auth (PocketBase)
PLOS_POCKETBASE_URL=
PLOS_POCKETBASE_ADMIN_TOKEN=
PLOS_AUTH_TOKEN_CACHE_TTL=60

# Memory pipeline
PLOS_MEMORY_L2_DEBOUNCE_SEC=4.0
PLOS_MEMORY_L3_IDLE_SEC=600.0

# WebSocket
PLOS_WS_PING_INTERVAL=20

# Runtime helpers
PLOS_SEED_ON_START=true
PLOS_AUTO_CREATE_TABLES=true
