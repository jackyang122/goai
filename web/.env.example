# ── Personal Learning OS — environment ──────────────────────────────
# This demo ships with a fully local MOCK backend (NEXT_PUBLIC_USE_MOCK=true),
# so it runs with zero external services. Flip the flags below to wire the
# real DeepTutor backend (FastAPI on :8001, proxied through the Next.js origin).

# Use the in-app mock API layer (no backend needed). Set to "false" to call a
# real backend via NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK=true

# DeepTutor origin. The browser only ever talks to this origin; DeepTutor's own
# Next.js middleware forwards /api/* and /ws/* to its FastAPI backend (:8001).
# For a standalone PLOS frontend pointed at a running DeepTutor instance:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3782

# Default agent persona for the demo ("teacher" | "peer" | "research")
NEXT_PUBLIC_DEFAULT_PERSONA=teacher
